{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": [
    "cdg1"
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{web/**,tests/**,scripts/**,.claude/**,.github/**}"
    }
  },
  "git": {
    "deploymentEnabled": false
  }
}
